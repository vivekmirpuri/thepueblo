{
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "trailingSlash": true
  },
  "firestore": {
    "rules": "firestore.rules",
    "location": "europe-southwest1"
  },
  "auth": {
    "providers": {
      "emailPassword": true
    }
  },
  "storage": {
    "rules": "storage.rules"
  }
}
