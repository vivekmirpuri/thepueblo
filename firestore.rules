rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAttendee(eventId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.attendeeIds;
    }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }

    match /users/{uid} {
      allow read: if signedIn();
      // "verified" (institutions) is only ever set by hand in the console
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.get('verified', false) == false;
      allow update: if signedIn() && request.auth.uid == uid && !changedKeys().hasAny(['verified']);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.organizerId == request.auth.uid
        && (request.resource.data.official == false || me().get('verified', false) == true);
      allow delete: if signedIn() && resource.data.organizerId == request.auth.uid;
      allow update: if signedIn() && (
        (resource.data.organizerId == request.auth.uid && !changedKeys().hasAny(['organizerId', 'official']))
        || isJoinOrLeave()
      );

      // a user may only add or remove themselves, and never past capacity
      function isJoinOrLeave() {
        let before = resource.data.attendeeIds.toSet();
        let after = request.resource.data.attendeeIds.toSet();
        let delta = after.difference(before).union(before.difference(after));
        return changedKeys().hasOnly(['attendeeIds', 'attendeeLanguages'])
          && delta.size() == 1 && delta.hasOnly([request.auth.uid])
          && request.resource.data.attendeeLanguages.diff(resource.data.attendeeLanguages).affectedKeys().hasOnly([request.auth.uid])
          && (resource.data.capacity == null || after.size() <= resource.data.capacity);
      }

      match /messages/{messageId} {
        allow read: if isAttendee(eventId);
        allow create: if isAttendee(eventId) && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
      // One review per person (the document id is their uid), only once the activity has started.
      match /reviews/{uid} {
        allow read: if true;
        allow create, update: if isAttendee(eventId) && request.auth.uid == uid
          && request.time >= get(/databases/$(database)/documents/events/$(eventId)).data.startsAt
          && request.resource.data.uid == uid
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && request.resource.data.text is string && request.resource.data.text.size() <= 500;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}
